            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"data.id bằng 2\", () => {",
                  "    pm.expect(res.data.id).to.eql(2);",
                  "});",
                  "",
                  "pm.test(\"data.email có đuôi @reqres.in\", () => {",
                  "    pm.expect(res.data.email).to.be.a(\"string\");",
                  "    pm.expect(res.data.email.endsWith(\"@reqres.in\")).to.be.true;",
                  "});"
