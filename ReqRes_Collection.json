  "item": [
    {
      "name": "Positive_Cases (Happy Path)",
      "item": [
        {
          "name": "POST - Register User / Get Auth Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\r\n\r\npm.test(\"Token exists\", () => {\r\n    pm.expect(pm.response.json()).to.have.property(\"token\");\r\n});\r\n\r\npm.environment.set(\"userToken\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n \"email\": \"eve.holt@reqres.in\",\r\n \"password\": \"pistol\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST - Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));\r\n\r\nconst res = pm.response.json();\r\n\r\npm.test(\"name khớp dữ liệu CSV\", () => {\r\n    pm.expect(res.name).to.eql(pm.iterationData.get(\"name\"));\r\n});\r\n\r\npm.test(\"job khớp dữ liệu CSV\", () => {\r\n    pm.expect(res.job).to.eql(pm.iterationData.get(\"job\"));\r\n});\r\n\r\npm.environment.set(\"userId\", res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [
                    "y5jkdbjXx/users.csv"
                  ]
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET - Single User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\r\n\r\nconst res = pm.response.json();\r\n\r\npm.test(\"data.id bằng 2\", () => {\r\n    pm.expect(res.data.id).to.eql(2);\r\n});\r\n\r\npm.test(\"data.email có đuôi @reqres.in\", () => {\r\n    pm.expect(res.data.email).to.be.a(\"string\");\r\n    pm.expect(res.data.email.endsWith(\"@reqres.in\")).to.be.true;\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
